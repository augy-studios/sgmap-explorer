# SG Map Explorer's server settings. Set these under the Vercel project's Settings, Environment
# Variables (Production, and Preview if you use it). For `vercel dev`, copy this file to
# .env.local and fill it in there. Placeholders only: never put a real value in this file.

# Supabase, for the server's cache (migrations/0001_server_cache.sql). Project Settings, API:
# the project URL and the service_role key (or a newer sb_secret_ key). Server-only. Optional:
# without them every layer still works, fetched from upstream as asked for, but bicycle parking
# only shows for the area in view and OneMap signs in again on each cold start. Slow layers fill
# it on demand; nothing here keeps the project awake.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Any long random string. Vercel Cron sends it to /api/cron (weekly: the island-wide bicycle
# parking sweep), which refuses calls without it.
CRON_SECRET=

# OneMap account (https://www.onemap.gov.sg/apidocs/), for OneMap's themes. The functions trade
# these for an API token and renew it every 3 days.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# data.gov.sg API key (https://data.gov.sg), for the weather, air, radar, flood, taxi and traffic
# camera layers. Optional: without it they still come, at data.gov.sg's lower rate limit.
DATA_GOV_KEY=

# LTA DataMall AccountKey (https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html),
# for bus stops, carparks, taxi stands, bicycle parking, EV chargers, EMAS signs and travel times,
# traffic incidents and faulty traffic lights.
LTA_ACCOUNT_KEY=

# ---- The Telegram bot (/api/telegram/webhook). See SETUP.md at the project root. ----

# From @BotFather: the bot's token, as 123456789:AA... Server-only.
TELEGRAM_BOT_TOKEN=

# Any random string of letters, digits, _ and - (1 to 256 characters), the same one passed to
# setWebhook as secret_token. The webhook refuses any call without it.
TELEGRAM_WEBHOOK_SECRET=

# Optional: the bot's username without the @, so in a group it answers only its own commands
# (/psi@ThisBot) and not another bot's.
TELEGRAM_BOT_USERNAME=

# Optional: the site's address, for the bot's "Open the map" buttons. Defaults to
# https://sgmap.uwuapps.org; set it on a preview deploy to link there instead.
SITE_URL=
