{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "cleanUrls": true,
    "regions": ["sin1"],
    "functions": {
        "api/cron.js": { "maxDuration": 300 },
        "api/layer/[id].js": { "maxDuration": 60 },
        "api/radar.js": { "maxDuration": 30 }
    },
    "crons": [
        { "path": "/api/cron", "schedule": "20 19 * * *" }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
            "source": "/i18n/(.*).json",
            "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
    ]
}
